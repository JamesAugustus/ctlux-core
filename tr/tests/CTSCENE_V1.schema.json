{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CTScene v1: metre / Z-up ortak sahne",
  "$comment": "Bu belge yapısal sözleşmedir. Dizi uzunluklarının birbirine oranı, xyz ve üçgen dizilerinin üçe bölünebilirliği, f/m indislerinin bağlı tablo sınırları, ışık kimliği tekilliği, birim yön normu, sonlu sayılar ve kaynak/doku yollarının gerçek proje sınırı içinde kalması JSON Schema ile bütünüyle doğrulanamaz. core/scene_model.py validate_scene(scene) yetkili çalışma zamanı doğrulayıcısıdır; kaynak yolları scene_from_project sırasında ayrıca çözülür. Uygulamanın kaynak/üçgen kotaları şemanın kalıcı format sınırı değildir. original özgün JSON metadata'yı korur; eski mutlak yollar varsa aktarım/gizlilik politikası paket katmanına aittir.",
  "type": "object",
  "required": ["schema", "version", "units", "up_axis", "name", "mesh", "lights", "warnings"],
  "properties": {
    "schema": {"const": "ctlux.scene"},
    "version": {"const": 1, "type": "integer"},
    "units": {"const": "m"},
    "up_axis": {"const": "Z"},
    "name": {"type": "string"},
    "mesh": {"$ref": "#/$defs/mesh"},
    "lights": {"type": "array", "items": {"$ref": "#/$defs/light"}},
    "camera": {"$ref": "#/$defs/camera"},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": {"$ref": "#/$defs/jsonValue"},
  "allOf": [{"if": {"properties": {"mesh": {"properties": {"f": {"maxItems": 0}}}}},
             "then": {"properties": {"lights": {"minItems": 1}}}}],
  "$defs": {
    "camera": {
      "type": "object",
      "required": [
        "type",
        "position",
        "direction",
        "up",
        "yfov_degrees",
        "aspect_ratio",
        "znear",
        "zfar"
      ],
      "properties": {
        "type": {
          "const": "perspective"
        },
        "position": {
          "$ref": "#/$defs/vector3"
        },
        "direction": {
          "$ref": "#/$defs/vector3"
        },
        "up": {
          "$ref": "#/$defs/vector3"
        },
        "yfov_degrees": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 179
        },
        "aspect_ratio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        },
        "znear": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "zfar": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "description": "İsteğe bağlı aktif perspektif kamera. Metre/Z-up; dikey görüş açısı derece. Çalışma zamanı doğrulayıcı sonluluk, yön/up bağımsızlığı ve far>near şartını da denetler."
    },
    "jsonValue": {
      "anyOf": [
        {"type": ["null", "boolean", "string", "number"]},
        {"type": "array", "items": {"$ref": "#/$defs/jsonValue"}},
        {"type": "object", "additionalProperties": {"$ref": "#/$defs/jsonValue"}}
      ]
    },
    "metadata": {"type": "object", "additionalProperties": {"$ref": "#/$defs/jsonValue"}},
    "numberArray": {"type": "array", "items": {"type": "number"}},
    "vector3": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
    "nonnegativeVector3": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": 0}},
    "size2": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 0}},
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![/\\\\])(?!.*:)(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$",
      "description": "Proje köküne göre yol. Mutlak yol, sürücü/URI öneki ve .. bileşeni içermez. Sembolik bağ denetimi builder'a aittir."
    },
    "material": {
      "type": "object",
      "required": ["name", "color"],
      "properties": {
        "name": {"type": "string"},
        "color": {"$ref": "#/$defs/nonnegativeVector3", "description": "Doğrusal RGB temel renk."},
        "texture": {"$ref": "#/$defs/relativePath"}
      },
      "additionalProperties": {"$ref": "#/$defs/jsonValue"}
    },
    "mesh": {
      "type": "object",
      "required": ["v", "f", "m", "uv", "uv_ok", "materials"],
      "properties": {
        "v": {"$ref": "#/$defs/numberArray", "minItems": 0, "description": "Düz xyz dizisi; metre, Z yukarı, dünya dönüşümü uygulanmış."},
        "f": {"type": "array", "minItems": 0, "items": {"type": "integer", "minimum": 0}, "description": "Üçlüler halinde köşe indisleri."},
        "m": {"type": "array", "minItems": 0, "items": {"type": "integer", "minimum": 0}, "description": "Her köşe için bir malzeme indisi."},
        "uv": {"$ref": "#/$defs/numberArray", "minItems": 0, "description": "Her köşe için iki UV sayısı; eksik UV'de sıfır dolgu ve uv_ok=0."},
        "uv_ok": {"type": "array", "minItems": 0, "items": {"type": "integer", "enum": [0, 1]}},
        "normals": {"$ref": "#/$defs/numberArray", "minItems": 3, "description": "İsteğe bağlı; her köşe için üç normal bileşeni."},
        "materials": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/material"}}
      },
      "additionalProperties": {"$ref": "#/$defs/jsonValue"}
    },
    "intensity": {
      "type": "object",
      "required": ["value", "unit", "provenance"],
      "properties": {
        "value": {"type": "number", "minimum": 0},
        "unit": {"enum": ["relative", "cd"]},
        "provenance": {"type": "string"}
      },
      "description": "relative fiziksel kandela değildir. IES dimmer'ı göreli çarpandır; profili ayrıca taşımak gerekir. cd yalnız fiziksel birim gerçekten biliniyorsa kullanılır.",
      "additionalProperties": {"$ref": "#/$defs/jsonValue"}
    },
    "light": {
      "type": "object",
      "required": ["id", "name", "position", "direction", "type", "color_linear", "enabled", "cone_angle_degrees", "radius_m", "size_m", "intensity", "source", "original"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string"},
        "position": {"$ref": "#/$defs/vector3"},
        "direction": {"$ref": "#/$defs/vector3", "description": "Dünya uzayında birim emisyon yönü."},
        "type": {"enum": ["point", "spot", "area", "distant"]},
        "color_linear": {"$ref": "#/$defs/nonnegativeVector3"},
        "enabled": {"type": "boolean"},
        "cone_angle_degrees": {"type": "number", "minimum": 0, "maximum": 180},
        "radius_m": {"type": "number", "minimum": 0},
        "size_m": {"$ref": "#/$defs/size2"},
        "intensity": {"$ref": "#/$defs/intensity"},
        "source": {"$ref": "#/$defs/metadata", "description": "Kaynak/ürün/dizilim kimlikleri ve proje içi bağlantılar."},
        "original": {"$ref": "#/$defs/metadata", "description": "Özgün ışık kaydının derin kopyası; bilinmeyen metadata değerleri dahil."}
      },
      "additionalProperties": {"$ref": "#/$defs/jsonValue"}
    }
  }
}
